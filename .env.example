# Holy Moly ! Environment Configuration
# Configure private project endpoints and keys via the Secrets panel in AI Studio.
# Never commit actual credentials into .env.example.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
WEBRTC_SIGNALING_URL=https://your-signaling-server.example.com
WEBRTC_SIGNALING_SECRET=your-signaling-shared-secret
WEBRTC_TURN_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/webrtc-turn-credentials
WEBRTC_TURN_URL=turn:your-turn-server:3478
WEBRTC_TURN_USERNAME=your-turn-username
WEBRTC_TURN_CREDENTIAL=your-turn-credential
