# Node.js + Socket.io WebRTC Signaling Server Configuration
# Copy to .env for local runs or set as environment variables in your host (Cloud Run, Fly.io, Railway, VPS).

PORT=3001
HOST=0.0.0.0

# Required: Shared family secret sent by clients during Socket.io handshake and /api/turn-credentials.
# Generate with: openssl rand -hex 32
SIGNALING_SHARED_SECRET=

# Optional: Comma-separated allowlist of up to 3 authorized family member IDs (uppercase).
ALLOWED_FAMILY_MEMBERS=MITHUN,MAFITHA,ZAYN

# Optional: Per-member 4-digit PIN map as JSON (e.g. {"MITHUN":"1234","MAFITHA":"5678","ZAYN":"9012"}).
# If set, clients must provide their matching member PIN in addition to or instead of SIGNALING_SHARED_SECRET.
FAMILY_MEMBER_PINS_JSON=

# Optional: Comma-separated allowed browser origins (e.g. https://app.yourdomain.com).
# Leave blank if only native Android/iOS clients connect (non-browser clients without an Origin header are permitted).
CORS_ORIGINS=

# Optional: Self-hosted coturn settings for POST /api/turn-credentials (short-TTL HMAC-SHA1 credentials).
TURN_DOMAIN=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=600

# Heartbeat / dead-socket sweep intervals in milliseconds.
HEARTBEAT_TIMEOUT_MS=20000
SWEEP_INTERVAL_MS=5000
